#!/bin/sh
# Push gate — the same checks as the pre-commit hook, run on every push.
# Closes the `git commit --no-verify` hole: a bypassed commit cannot reach
# the remote unnoticed. Deliberate WIP pushes: `git push --no-verify`.
set -e
export PATH="$HOME/.cargo/bin:$PATH"
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] cargo fmt --check"
cargo fmt --all -- --check

echo "[pre-push] cargo clippy"
cargo clippy --workspace --all-targets --quiet -- -D warnings

echo "[pre-push] cargo test"
cargo test --workspace --quiet
